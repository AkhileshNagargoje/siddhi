{
  "$schema": "./node_modules/wrangler/config-schema.json",
  // Cloudflare service name, NOT the product name. The product is Siddhi;
  // this string is the deployment identity that owns the live custom domain.
  // Renaming it creates a second Worker and the route attach fails, so it is
  // deliberately left alone. Public hostnames (health.*) carry no product name.
  "name": "atreya",
  "compatibility_date": "2026-08-01",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application"
  },
  "routes": [
    { "pattern": "health.akhileshnagargoje.in", "custom_domain": true }
  ],
  "observability": {
    "enabled": true
  }
}
