{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "siddhi",
  "compatibility_date": "2026-08-01",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application"
  },
  "routes": [
    { "pattern": "siddhi.akhileshnagargoje.in", "custom_domain": true }
  ],
  "observability": {
    "enabled": true
  }
}
