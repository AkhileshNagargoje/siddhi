{
  "$schema": "./node_modules/wrangler/config-schema.json",
  // Cloudflare service name, NOT the product name. The product is Siddhi;
  // this string is the deployment identity that owns the live custom domain.
  // Renaming it creates a second Worker and the route attach fails, so it is
  // deliberately left alone. Public hostnames (health.*) carry no product name.
  "name": "atreya-engine",
  "main": "src/index.js",
  "compatibility_date": "2026-08-01",
  "triggers": {
    // every 5 minutes: run detection scan (PROJECT.md spec)
    // every minute: generate a slice of live clinic traffic so the demo is always alive
    "crons": ["*/5 * * * *", "* * * * *"]
  },
  "vars": {
    "SUPABASE_URL": "https://ommnjuedmzffiawhkdqi.supabase.co",
    // Publishable (anon) key — public by design, already shipped in the frontend bundle.
    // Kept as a var, not a secret, so any teammate can redeploy reproducibly.
    "SUPABASE_KEY": "sb_publishable_P2D7fSeuoaqc1tgURDXeoA_dDfff-Dk",
    "GENERATE_TRAFFIC": "true"
  },
  "routes": [
    { "pattern": "health-engine.akhileshnagargoje.in", "custom_domain": true }
  ],
  "observability": {
    "enabled": true
  }
}
